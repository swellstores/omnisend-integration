{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omnisend",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "upload_source_maps": false
}
